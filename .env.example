# Docker Compose 2.24+; select any combination: ffa,ktx,qtv,proxy
COMPOSE_PROFILES=ffa
QW_PAK_DIR=./pak_files

# Shared defaults; individual services can override these in compose.yaml.
QW_RCON_PASSWORD=
QW_ADMIN_PASSWORD=
QW_PASSWORD=
QW_SPECTATOR_PASSWORD=
QW_QTV_PASSWORD=
QW_QTV_ENABLED=1
QW_MAXCLIENTS=16
QW_MAXSPECTATORS=8
QW_TIMELIMIT=10
QW_FRAGLIMIT=50
QW_DEMO_MAX_MB=1024
QW_DEMO_FILE_MAX_MB=64
QW_COUNTRYCODE=SE
QW_CITY=Stockholm
QW_COORDS=59.3327,18.0656
QW_ADMININFO=

FFA_PORT=27500
KTX1_PORT=27501
KTX2_PORT=27502
KTX3_PORT=27503
KTX4_PORT=27504
KTX1_MODE=1on1
KTX2_MODE=1on1
KTX3_MODE=2on2
KTX4_MODE=4on4

QTV_PORT=28000
QTV_HOSTNAME=QuakeWorld TV
QTV_PUBLIC_ADDRESS=
QTV_PASSWORD=
QTV_MAXCLIENTS=100
QTV_DELAY=10
# Limit this list to the game services you actually run.
QTV_SOURCES=ffa:27500 ktx-1:27500 ktx-2:27500 ktx-3:27500 ktx-4:27500
QWFWD_PORT=30000
QWFWD_HOSTNAME=QuakeWorld proxy
QWFWD_PUBLIC_ADDRESS=
